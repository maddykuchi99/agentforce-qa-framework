# Agentforce Agents Registry
# ---------------------------
# Lives at: <repo-root>/.claude/agents-registry.yml
#
# This file is read by the qa-test-agent and qa-fleet-rollup subagents.
# Each entry under `agents:` defines one Agentforce agent that QA will test.
# Add a new agent here when the team builds it; remove when retired.

# Shared defaults — applied to every agent unless overridden on its entry
defaults:
  strategy_doc_path: docs/Agentforce_Testing_Strategy.md
  tier_convention: suffix          # 'suffix' | 'tag' | 'custom'
  fleet_digest_path: qa-digests/fleet
  fleet_notification: "#qa-leadership"   # channel for fleet rollup notifications; set to 'none' to disable

# Per-agent definitions
agents:

  acc-email-agent:
    label: ACC Email Agent
    sf_alias: qa-sandbox             # Update to your actual Salesforce CLI org alias
    sf_agent_api_name: ACC_Email_Agent
    # GenAiPlannerBundle metadata file — topics are embedded inside this file
    bundle_metadata_path: force-app/main/default/genAiPlannerBundles/ACC_Email_Agent.genAiPlannerBundle-meta.xml
    digest_path: qa-digests/acc-email-agent
    notification: "#email-agent-qa"
    owner: customer-service-team
    schedule: daily
    jira_csv_path: jira-exports/Email Stories.csv
    # Testable topics extracted from the bundle (system topics like topic_selector excluded)
    topics:
      - name: order_status
        label: Order Status
        action: send_order_status_reply    # Apex: ACC_EmailOrderStatusResponse
        can_escalate: false
      - name: general_inquiry
        label: General Inquiry
        action: none
        can_escalate: false

  # Add additional agents below following the same shape.
  # Example (update bundle_metadata_path and topics to match the agent's XML):
  #
  # acc-chat-agent:
  #   label: ACC Chat Agent
  #   sf_alias: qa-sandbox
  #   sf_agent_api_name: ACC_Chat_Agent
  #   bundle_metadata_path: force-app/main/default/genAiPlannerBundles/ACC_Chat_Agent.genAiPlannerBundle-meta.xml
  #   digest_path: qa-digests/acc-chat-agent
  #   notification: "#chat-agent-qa"
  #   owner: support-team
  #   schedule: daily
  #   topics:
  #     - name: <topic_developer_name>
  #       label: <Topic Label>
  #       action: <action_developer_name or none>
  #       can_escalate: true/false
